APP_NAME="Homstech OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://your-domain.hostingerapp.com
APP_INSTALLED=false

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,structured
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
GLOBAL_RATE_LIMIT=120
UPLOAD_MAX_MB=10

DB_CONNECTION=mysql
DB_HOST=your-managed-mysql-host
DB_PORT=3306
DB_DATABASE=homstech
DB_USERNAME=homstech
DB_PASSWORD=secret
DB_PREFIX=
DB_SOCKET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=your-domain.hostingerapp.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=homstech_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Financeiro / Notificações
WHATSAPP_TOKEN=null
WHATSAPP_PHONE_ID=
WHATSAPP_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_RETRIES=3
WHATSAPP_BACKOFF=200
FISCAL_DRIVER=mock

SANCTUM_STATEFUL_DOMAINS=your-domain.hostingerapp.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
